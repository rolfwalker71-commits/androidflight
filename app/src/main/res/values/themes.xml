<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlightBuddy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#141218</item>
    </style>
    <style name="Theme.FlightBuddy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#141218</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FlightBuddy</item>
    </style>
</resources>
