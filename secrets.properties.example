# Copy values into gitignored local.properties (never commit real keys).
# The debug build reads these names from local.properties and seeds EncryptedSharedPreferences
# on first launch. You can also paste keys in Settings.

# Android SDK (required for IDE sync and ./gradlew)
# sdk.dir=/home/you/Android/Sdk

# OpenSky OAuth2 client (USERNAME = client_id, PASSWORD = client_secret)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
# Optional aliases
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
OPENSKY_MIN_INTERVAL_MS=90000

# AeroDataBox / AeroDataSoft via API.Market (x-api-market-key). Not RapidAPI.
# Both KEY and HOST (or BASE_URL) are required for official schedules.
AERODATABOX_KEY=
AERODATABOX_HOST=prod.api.market/api/v1/aedbx/aerodatabox
AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox

# FlightRadar24 official API (Bearer token)
FR24_API_TOKEN=
FR24_ENABLED=true
FR24_MIN_INTERVAL_MS=180000
